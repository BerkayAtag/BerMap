{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bermap_db;Username=postgres;Password=postgres"
  },
  "BerMap": {
    "InstanceName": "BerMap-Enterprise-Prod",
    "Environment": "OnPremises",
    "AirGapped": true,
    "Collector": {
      "HeartbeatTimeoutSeconds": 60,
      "QueueMaxDiskMb": 500
    }
  }
}
