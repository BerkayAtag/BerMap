{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bermap_db;Username=postgres;Password=postgres"
  },
  "BerMap": {
    "InstanceName": "BerMap-Enterprise-Prod",
    "Environment": "OnPremises",
    "AirGapped": true,
    "Database": {
      "ApplyMigrationsOnStartup": true
    },
    "Auth": {
      "TokenLifetimeMinutes": 480
    },
    "DiscoveryScheduler": {
      "Enabled": true,
      "PollSeconds": 30,
      "TimeZone": ""
    },
    "ReverseProxy": {
      "KnownProxies": []
    },
    "Bootstrap": {
      "AdminUsername": "admin",
      "AdminPassword": ""
    },
    "CredentialVault": {
      "Directory": ""
    },
    "Collectors": {
      "EnrollmentToken": "",
      "HeartbeatTimeoutSeconds": 90
    }
  }
}
