{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bermap_dev;Username=bermap_dev;Password=bermap_dev"
  },
  "BerMap": {
    "InstanceName": "BerMap-Dev",
    "Environment": "Development",
    "AirGapped": false,
    "CredentialVault": {
      "Directory": "./.bermap-vault"
    },
    "Collectors": {
      "EnrollmentToken": "dev-enrollment-token-00000000000000000000000000000000",
      "HeartbeatTimeoutSeconds": 90
    },
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:3000",
        "https://localhost:3000",
        "http://localhost:5173",
        "https://localhost:5173"
      ]
    }
  }
}