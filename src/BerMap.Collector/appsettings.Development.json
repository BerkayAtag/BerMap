{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "BerMap": {
    "ServerUrl": "http://localhost:5294",
    "Collector": {
      "EnrollmentToken": "dev-enrollment-token-00000000000000000000000000000000",
      "DataDirectory": "",
      "QueueMaxDiskMb": 100,
      "Integrations": [
        // Each entry is an integration created on the server with "collector managed"
        // turned on; IntegrationId is its id. Configuration is the adapter configuration
        // exactly as the server wizard stores it, without the password: the secret is read
        // before every run from SecretFile (a file that contains only the secret) or from
        // SecretEnvironmentVariable. Schedule is a 5-field cron in the collector's local time.
        //
        // {
        //   "IntegrationId": "00000000-0000-0000-0000-000000000000",
        //   "AdapterType": "ActiveDirectory",
        //   "Schedule": "0 */6 * * *",
        //   "RunOnStart": true,
        //   "TimeoutSeconds": 1800,
        //   "SecretFile": "/etc/bermap/secrets/ad-corp.secret",
        //   "Configuration": {
        //     "server": "dc01.corp.local",
        //     "port": 636,
        //     "useSsl": true,
        //     "username": "svc-bermap@corp.local",
        //     "baseDn": "DC=corp,DC=local"
        //   }
        // },
        // {
        //   "IntegrationId": "00000000-0000-0000-0000-000000000000",
        //   "AdapterType": "VMware",
        //   "Schedule": "30 */2 * * *",
        //   "SecretEnvironmentVariable": "BERMAP_VCENTER_PASSWORD",
        //   "Configuration": {
        //     "server": "vcenter.corp.local",
        //     "username": "svc-bermap@vsphere.local"
        //   }
        // }
      ]
    }
  }
}
